# ---- 服务 ----
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
DATA_DIR=data

# 生产必须显式设置，否则重启后会话与上游凭据全部失效
# SESSION_SECRET=<64 位 hex>
# ENCRYPTION_KEY=<64 位 hex>

# ---- 上游 ----
# mock = 内置夹具平台（默认，开箱即用）
# educoder = 真实头歌 API
UPSTREAM=mock
EDUCODER_BASE=https://data.educoder.net/api
EDUCODER_WEB=https://www.educoder.net
# 平台公开客户端签名常量；平台换版本后用 node scripts/extract-aksk.mjs 重新提取
EDUCODER_AK=e9dd5b4322f9f7d83d009de9bfa100c3
EDUCODER_SK=2e3da06ae26ba9f76a5d8d355746f2fe

# ---- 求解器 ----
# mock = 确定性答案（默认）；openai = OpenAI 兼容 /chat/completions
SOLVER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 业务开关 ----
ACCESS_CARD_REQUIRED=false
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# ---- 限额 ----
WORKER_CONCURRENCY=2
LIMIT_ATTEMPTS=3
LIMIT_JOB_MINUTES=30
LIMIT_COLLECT_MINUTES=3
LIMIT_COLLECT_READS=200
RATE_LOGIN_MAX=10
