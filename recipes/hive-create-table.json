{
  "id": "hive-create-table",
  "title": "在 Hive 里建表并自检（Hive Shell 入门类）",
  "match": {
    "subject_any": ["Hive Shell", "Hive"],
    "description_any": ["创建表", "create table", "HiveQL", "desc student", "表结构"],
    "file_any": ["test.sh"]
  },
  "min_score": 5,
  "depends_on": "hive-install",
  "setup": [
    "export HIVE_HOME=/opt/hive; export PATH=$HIVE_HOME/bin:$PATH",
    "/opt/hive/bin/hive -e \"create table if not exists student(id int, name string, age int);\" 2>&1 | tail -2",
    "/opt/hive/bin/hive -S -e \"show tables;\" 2>&1 | tail -3"
  ],
  "verify": {
    "command": "/opt/hive/bin/hive -S -e \"show tables;desc student;\"",
    "expect": "student"
  },
  "repair": [
    "/usr/local/hadoop/sbin/start-dfs.sh >/dev/null 2>&1; sleep 10",
    "/opt/hive/bin/hive -e \"create table if not exists student(id int, name string, age int);\" 2>&1 | tail -2"
  ]
}
